<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Point Incremential 2</title>
    <style>
      body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: #08120d;
        color: #eafef3;
      }
      .wrap {
        max-width: 900px;
        margin: 0 auto;
        padding: 48px 20px;
      }
      h1 {
        font-size: 48px;
        margin: 0 0 20px;
      }
      p {
        color: #cfe9d6;
        line-height: 1.6;
      }
      .btn {
        display: inline-block;
        background: #4bdc13;
        color: #06160d;
        padding: 12px 18px;
        text-decoration: none;
        font-weight: bold;
        border-radius: 10px;
        margin-top: 10px;
      }
      .card {
        background: #0f1e17;
        border: 1px solid #254b3b;
        border-radius: 14px;
        padding: 20px;
        margin-top: 30px;
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <h1>Point Incremential 2</h1>
      <p>
        Endgame 1e10 Points. A prestige-based incremental game focused on
        multipliers, automation, and long-form progression.
      </p>
      <a class="btn" href="https://github.com/Spotky2010-ops/Point-incremential-2" target="_blank">
        View Repository
      </a>

      <div class="card">
        <h2>Features</h2>
        <p>• Prestige mechanics</p>
        <p>• Upgrade boosters</p>
        <p>• Auto prestige</p>
        <p>• Endgame scaling toward 1e10</p>
      </div>
    </div>
  </body>
</html>
